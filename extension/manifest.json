{
  "manifest_version": 3,
  "name": "Manhwa Lens — English Translator",
  "version": "1.1.0",
  "description": "Read Korean, Japanese and Chinese image text in English with local OCR and removable translations.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "background.js", "type": "module"},
  "icons": {"16":"icons/16.png","32":"icons/32.png","48":"icons/48.png","128":"icons/128.png"},
  "action": {"default_icon":{"16":"icons/16.png","32":"icons/32.png"},"default_popup": "popup.html", "default_title": "Manhwa Lens"},
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "select-region": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Select a comic region or speech bubble to translate"
    },
    "toggle-translations": {
      "suggested_key": {
        "default": "Ctrl+Shift+Z",
        "mac": "Command+Shift+Z"
      },
      "description": "Hide or show English translations"
    },
    "clear-translations": {
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "Remove all translations on the page"
    }
  },
  "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self';"}
}
