{
  "name": "manhwa-lens",
  "version": "1.1.0",
  "description": "Free, open-source Chrome/Edge extension for real-time local OCR and English translation of Korean Manhwa, Japanese Manga, and Chinese Webtoons.",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/dag-bag/manhwa-lens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dag-bag/manhwa-lens.git"
  },
  "bugs": {
    "url": "https://github.com/dag-bag/manhwa-lens/issues"
  },
  "license": "MIT",
  "keywords": [
    "manhwa",
    "manhwa-translator",
    "manga",
    "manga-translator",
    "webtoon",
    "webtoon-translator",
    "ocr",
    "korean-ocr",
    "korean-translator",
    "japanese-manga",
    "chinese-manhua",
    "tesseract-js",
    "webassembly",
    "wasm-ocr",
    "offline-ocr",
    "chrome-extension",
    "edge-extension",
    "manifest-v3",
    "image-translation",
    "speech-bubble-detection",
    "scanlation",
    "scanlation-tool",
    "comic-translator"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:panel": "node tests/user-panel.mjs"
  },
  "dependencies": {
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "playwright": "1.58.2"
  }
}
